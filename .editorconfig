# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# 本项目在 Linux 上部署，并在 Windows 上开发 —— 强制 LF 可以避免
# shell 脚本报 "set: pipefail: invalid option name" 这类问题。
# 守卫：tools/fix_line_endings.py --check（CI 中也会跑）

[*.py]
indent_style = space
indent_size = 4
max_line_length = 110

[*.{js,css,html,json,yml,yaml}]
indent_style = space
indent_size = 2

[*.md]
# Markdown 里行尾两空格表示硬换行，不要裁掉
trim_trailing_whitespace = false

[*.sh]
indent_style = space
indent_size = 2

[*.{service,timer}]
indent_style = space
indent_size = 4

[Makefile]
indent_style = tab
