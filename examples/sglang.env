# SGLang 配置档案 / SGLang profile
# 用法 / Usage:  cp examples/sglang.env .env

# **注意端口**：SGLang 默认监听 30000，不是 8080
# NOTE THE PORT: SGLang listens on 30000 by default, not 8080.
LLMCONSOLE_LLAMA_UNIT=sglang.service
LLMCONSOLE_LLAMA_BASE_URL=http://127.0.0.1:30000

LLMCONSOLE_PORT=8081
LLMCONSOLE_LOG_LEVEL=INFO

# 能力差异 / Capability differences:
#   SGLang 提供 /get_model_info、/get_server_info、/v1/models 与 /metrics
#   （前缀 sglang:），但**不提供** /slots。
#   版本号取自 /get_server_info 的 version 字段。
#
#   SGLang exposes /get_model_info, /get_server_info, /v1/models and /metrics
#   (prefix sglang:), but NOT /slots.
#   The version comes from the `version` field of /get_server_info.
#
# 确认 SGLang 在跑 / verify SGLang is up:
#   curl -s http://127.0.0.1:30000/get_model_info
#   curl -s http://127.0.0.1:30000/get_server_info
