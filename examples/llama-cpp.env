# 推理服务端口与单元名 / Inference service ports and unit names
# 用法 / Usage:  cp examples/llama-cpp.env .env

# llama.cpp（llama-server）默认监听 8080
LLMCONSOLE_LLAMA_UNIT=llama-server.service
LLMCONSOLE_LLAMA_BASE_URL=http://127.0.0.1:8080

LLMCONSOLE_PORT=8081
LLMCONSOLE_LOG_LEVEL=INFO

# llama.cpp 提供 /props 与 /slots，因此槽位明细与 KV 容量面板可用。
# llama.cpp exposes /props and /slots, so per-slot detail and KV capacity are available.
#
# 采集频率（按需调整；调密会挤占推理服务资源）
# LLMCONSOLE_POLL_INTERVAL_S=2.0
# LLMCONSOLE_CONFIG_POLL_INTERVAL_S=60.0

# 告警阈值（先用默认值观察几天，再按自己机器的基线调整）
# LLMCONSOLE_GPU_TEMP_WARN_C=83.0
# LLMCONSOLE_KV_WARN_PCT=85.0
#
# 绝对不要手填基线：留空 = 自动学习。写死基线会让换模型后告警持续误报。
# NEVER hard-code the baseline: leave it unset so it is auto-learned.
# LLMCONSOLE_MTP_ACCEPT_BASELINE=
# LLMCONSOLE_DECODE_BASELINE_TPS=
