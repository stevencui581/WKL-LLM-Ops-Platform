# Ollama 配置档案 / Ollama profile
# 用法 / Usage:  cp examples/ollama.env .env

# **注意端口**：Ollama 默认监听 11434，不是 8080
# NOTE THE PORT: Ollama listens on 11434 by default, not 8080.
LLMCONSOLE_LLAMA_UNIT=ollama.service
LLMCONSOLE_LLAMA_BASE_URL=http://127.0.0.1:11434

LLMCONSOLE_PORT=8081
LLMCONSOLE_LOG_LEVEL=INFO

# 能力差异 / Capability differences:
#   Ollama 不提供 /props 与 /slots，只有 /api/version、/api/tags、/api/ps。
#   控制台会自动隐藏槽位面板，并明确说明「该框架不提供此接口」——
#   这是能力差异，不是故障。
#
#   Ollama exposes neither /props nor /slots. The console hides the slot panel
#   and states that the framework does not provide the API. That is a capability
#   difference, not a failure.
#
# 确认 Ollama 在跑 / verify Ollama is up:
#   curl -s http://127.0.0.1:11434/api/version
