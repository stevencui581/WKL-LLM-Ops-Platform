# =============================================================================
# Git 属性 —— 从版本控制层面强制行尾与文本处理
#
# **为什么这个文件很重要**
#   本项目在 Linux 上部署、也有人在 Windows 上开发。Windows 的编辑器与 Python
#   默认会写出 CRLF 行尾，传回 Linux 后会造成三类**静默故障**：
#
#     * shell 脚本报 `set: pipefail: invalid option name`（把 pipefail\r 当选项名）
#     * 无扩展名的配置文件（如 deploy/sudoers.llm-console）解析失败
#     * CSV 数据文件第一列列名多出 \ufeff
#
#   在这里声明 `text eol=lf` 之后，git 会在 checkout 时就把行尾归一为 LF，
#   比"事后用工具修"可靠得多。
# =============================================================================

# 默认：自动识别文本文件，仓库内统一 LF
* text=auto eol=lf

# ---- 明确指定为文本并使用 LF ----
*.py        text eol=lf
*.js        text eol=lf
*.css       text eol=lf
*.html      text eol=lf
*.json      text eol=lf
*.md        text eol=lf
*.sh        text eol=lf
*.toml      text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.txt       text eol=lf
*.cff       text eol=lf
*.service   text eol=lf
*.timer     text eol=lf
*.sudoers   text eol=lf
*.env       text eol=lf
*.example   text eol=lf

# 没有扩展名的关键文件（最容易漏，也最容易出静默故障）
sudoers.llm-console   text eol=lf
install.sh            text eol=lf
update.sh             text eol=lf
uninstall.sh          text eol=lf
selfcheck.sh          text eol=lf
VERSION               text eol=lf
.python-version       text eol=lf

# ---- 二进制文件：不做任何换行转换 ----
*.docx      binary
*.xlsx      binary
*.pptx      binary
*.pdf       binary
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.webp      binary
*.ico       binary
*.zip       binary
*.gz        binary
*.tgz       binary

# ---- 让 GitHub 语言统计更准确 ----
static/*    linguist-vendored=false
docs/*      linguist-documentation
tests/*     linguist-detectable=true

# ---- diff 行为 ----
*.md        diff=markdown
CHANGELOG*  merge=union
