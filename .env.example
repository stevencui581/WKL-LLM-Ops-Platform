# =============================================================================
# WKL-LLM运维平台 配置示例 / Configuration example
#
# 用法 / Usage:
#   cp .env.example .env      # 然后按需修改 / then edit as needed
#
# 优先级 / Precedence:  环境变量 > .env > app/config.py 的默认值
#                       environment > .env > defaults in app/config.py
#
# 全部可用参数见 / full reference:  docs/CONFIGURATION.md
# =============================================================================

# -----------------------------------------------------------------------------
# 被监控对象 / Monitored target  —— 部署时最需要改的部分
# -----------------------------------------------------------------------------

# 推理服务的 systemd 单元名 / systemd unit of the inference service
#   查看实际名称 / find the real name:
#     systemctl list-units --type=service --state=running | grep -Ei 'llama|ollama|vllm|sglang'
LLMCONSOLE_LLAMA_UNIT=llama-server.service

# 推理服务 HTTP 地址 / inference service base URL
#   llama.cpp  http://127.0.0.1:8080
#   Ollama     http://127.0.0.1:11434
#   vLLM       http://127.0.0.1:8000
#   SGLang     http://127.0.0.1:30000
LLMCONSOLE_LLAMA_BASE_URL=http://127.0.0.1:8080

# 控制台自身的 systemd 单元名（用于自监控）/ the console's own unit
LLMCONSOLE_CONSOLE_UNIT=llm-console.service

# -----------------------------------------------------------------------------
# 服务监听 / Listening
# -----------------------------------------------------------------------------
LLMCONSOLE_HOST=0.0.0.0
LLMCONSOLE_PORT=8081

# -----------------------------------------------------------------------------
# 日志 / Logging
# -----------------------------------------------------------------------------
# DEBUG / INFO / WARNING / ERROR
LLMCONSOLE_LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# 推理框架识别 / Framework detection（v0.5 新增）
# -----------------------------------------------------------------------------
# 识别失败时的重试间隔（秒）。覆盖"先起控制台、后起推理服务"的场景。
# Retry interval in seconds when detection fails.
# LLMCONSOLE_FRAMEWORK_REDETECT_S=30.0

# -----------------------------------------------------------------------------
# 采集频率 / Collection intervals
# -----------------------------------------------------------------------------
# 主采集节拍（秒）/ main tick in seconds
# LLMCONSOLE_POLL_INTERVAL_S=2.0
# 模型参数轮询（变化很慢）/ model props polling（changes slowly）
# LLMCONSOLE_CONFIG_POLL_INTERVAL_S=60.0
# HTTP 超时 / HTTP timeout
# LLMCONSOLE_HTTP_TIMEOUT_S=1.0

# -----------------------------------------------------------------------------
# 告警阈值 / Alert thresholds
# -----------------------------------------------------------------------------
# 显卡温度 / GPU temperature
# LLMCONSOLE_GPU_TEMP_WARN_C=83.0
# LLMCONSOLE_GPU_TEMP_CRIT_C=87.0
# 显存占用百分比 / VRAM usage percent
# LLMCONSOLE_VRAM_WARN_PCT=90.0
# LLMCONSOLE_VRAM_CRIT_PCT=95.0
# KV 容量百分比 / KV capacity percent
# LLMCONSOLE_KV_WARN_PCT=85.0
# LLMCONSOLE_KV_CRIT_PCT=95.0
# 事件型告警自动恢复时长（秒）/ event alert auto-resolve TTL in seconds
# LLMCONSOLE_EVENT_ALERT_TTL_S=60.0

# 基线：保持注释 = 自动学习（**强烈建议**）
# Baseline: leave commented = auto-learn（**strongly recommended**）
# 写死基线会导致换机器/换模型后告警持续误报。
# LLMCONSOLE_MTP_ACCEPT_BASELINE=0.59
# LLMCONSOLE_DECODE_BASELINE_TPS=72.5

# -----------------------------------------------------------------------------
# 历史服务日志 / Service log history
# -----------------------------------------------------------------------------
# LLMCONSOLE_LOG_HISTORY_DAYS_OPTIONS=[1,7,30]
# LLMCONSOLE_LOG_HISTORY_DEFAULT_DAYS=30
# 单次拉取行数**必须 >= 最大档位能产生的行数**，否则会出现
# "选 30 天却只覆盖 1 天"。 / must be >= lines produced by the largest range.
# LLMCONSOLE_LOG_HISTORY_DEFAULT_LIMIT=15000

# -----------------------------------------------------------------------------
# 服务管理 / Service control
# -----------------------------------------------------------------------------
# 设为空数组可完全关闭服务管理能力 / set to [] to disable service control
# LLMCONSOLE_SERVICE_ACTIONS=["restart","stop","start"]

# -----------------------------------------------------------------------------
# 多语言 / i18n
# -----------------------------------------------------------------------------
# auto = 跟随浏览器 / follow the browser;  或 zh / en
LLMCONSOLE_DEFAULT_LANG=auto

# -----------------------------------------------------------------------------
# 硬件清点 / Hardware inventory
# -----------------------------------------------------------------------------
# 认可算力卡的 PCI 厂商 ID：NVIDIA=10de, AMD=1002
# Accepted accelerator PCI vendor IDs
# LLMCONSOLE_ACCEL_VENDOR_ALLOWLIST=["10de","1002"]
# 用指定的 Python 探测 PyTorch 等（多环境机器）/ probe with a specific Python
# LLMCONSOLE_HW_EXTERNAL_PYTHON=/opt/conda/bin/python
