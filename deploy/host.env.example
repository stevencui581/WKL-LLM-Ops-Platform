# 部署连接配置示例 —— 复制为 deploy/host.env 后填写自己的值
#
#   cp deploy/host.env.example deploy/host.env
#
# deploy/host.env 已加入 .gitignore，**不会被提交到仓库**。
# 也可以用环境变量代替本文件（同名变量，环境变量优先）。

# 目标服务器
WKL_HOST=192.0.2.10
WKL_PORT=22
WKL_USER=llmops
WKL_PASSWORD=change-me

# 部署根目录（控制台代码与 venv 所在位置）
WKL_ROOT=/opt/WKL-LLM-Ops-Platform

# sudo 密码（仅当目标机上 sudo 需要密码时填写；用于安装服务/写 sudoers）
WKL_SUDO_PASSWORD=
